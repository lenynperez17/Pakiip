# ============================================
# PostgreSQL Database
# ============================================
DATABASE_URL="postgresql://usuario:password@host:5432/database"

# ============================================
# NextAuth.js Configuration
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secret-seguro-aqui"

# Google OAuth (obtener desde Google Cloud Console)
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"

# ============================================
# Google Maps API Key
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="tu-google-maps-api-key"

# ============================================
# Backend Selection
# ============================================
NEXT_PUBLIC_BACKEND="postgresql"

# Nota: NUNCA subas archivos .env/.env.local al repositorio
# Estos archivos deben estar en .gitignore y contienen credenciales reales
