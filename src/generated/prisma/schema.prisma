// Schema de Prisma para Pakiip
// Base de datos: PostgreSQL en VPS

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  customer
  vendor
  driver
  admin
}

enum EntityStatus {
  Activo
  Inactivo
  Pendiente
  Rechazado
}

enum OrderStatus {
  Procesando
  ListoParaRecoger
  EsperandoAceptacion
  Enviado
  Entregado
  Cancelado
}

enum VehicleType {
  Moto
  Coche
  Bicicleta
  Mototaxi
}

enum PaymentMethodType {
  bank
  qr
  cash
  gateway
}

enum TransactionType {
  debit
  credit
}

enum CoinTransactionType {
  earned
  spent
  bonus
}

enum FavorStatus {
  Pendiente
  Aceptado
  EnCamino
  Completado
  Cancelado
}

enum TaxType {
  gravada
  exonerada
  inafecta
}

// ============================================
// USUARIOS Y AUTENTICACION
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  name            String
  phone           String?
  dni             String?
  city            String?
  sector          String?
  address         String?
  lat             Decimal?  @db.Decimal(10, 8)
  lng             Decimal?  @db.Decimal(11, 8)
  profileImageUrl String?   @map("profile_image_url")
  coins           Int       @default(0)
  emailVerified   DateTime? @map("email_verified")
  phoneVerified   Boolean   @default(false) @map("phone_verified")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relaciones
  roles            UserRoleAssignment[]
  settings         UserSettings?
  oauthAccounts    OAuthAccount[]
  sessions         Session[]
  orders           Order[]
  coinTransactions CoinTransaction[]
  favors           Favor[]
  cart             Cart?
  messages         Message[]
  vendor           Vendor?
  driver           Driver?
  admin            Admin?

  @@map("users")
}

model UserRoleAssignment {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  role     UserRole
  isActive Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model UserSettings {
  userId       String   @id @map("user_id")
  selectedRole UserRole @default(customer) @map("selected_role")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  provider          String
  providerAccountId String    @map("provider_account_id")
  accessToken       String?   @map("access_token")
  refreshToken      String?   @map("refresh_token")
  expiresAt         DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  sessionToken String   @unique @map("session_token")
  expiresAt    DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================
// CATEGORIAS Y CIUDADES
// ============================================

model Category {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?  @map("image_url")
  imageHint String?  @map("image_hint")
  createdAt DateTime @default(now()) @map("created_at")

  vendors Vendor[]

  @@map("categories")
}

model City {
  id   String   @id @default(cuid())
  name String
  lat  Decimal? @db.Decimal(10, 8)
  lng  Decimal? @db.Decimal(11, 8)

  sectors       CitySector[]
  deliveryZones DeliveryZone[]
  vendors       Vendor[]

  @@map("cities")
}

model CitySector {
  id     String  @id @default(cuid())
  cityId String  @map("city_id")
  name   String
  fee    Decimal @default(0) @db.Decimal(10, 2)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("city_sectors")
}

model DeliveryZone {
  id          String  @id @default(cuid())
  name        String
  cityId      String  @map("city_id")
  path        Json // Array de {lat, lng}
  shippingFee Decimal @map("shipping_fee") @db.Decimal(10, 2)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("delivery_zones")
}

// ============================================
// VENDORS (TIENDAS)
// ============================================

model Vendor {
  id                String            @id @default(cuid())
  ownerId           String?           @unique @map("owner_id")
  name              String
  email             String
  phone             String?
  dni               String?
  description       String?
  categoryId        String?           @map("category_id")
  logoUrl           String?           @map("logo_url")
  bannerUrl         String?           @map("banner_url")
  address           String?
  cityId            String?           @map("city_id")
  lat               Decimal?          @db.Decimal(10, 8)
  lng               Decimal?          @db.Decimal(11, 8)
  isFeatured        Boolean           @default(false) @map("is_featured")
  commissionRate    Decimal           @default(0) @map("commission_rate") @db.Decimal(5, 2)
  additionalFee     Decimal           @default(0) @map("additional_fee") @db.Decimal(10, 2)
  status            EntityStatus      @default(Pendiente)
  paymentMethod     PaymentMethodType @default(bank) @map("payment_method")
  bankName          String?           @map("bank_name")
  bankAccountNumber String?           @map("bank_account_number")
  bankAccountHolder String?           @map("bank_account_holder")
  qrImageUrl        String?           @map("qr_image_url")
  qrPaymentName     String?           @map("qr_payment_name")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  owner             User?                   @relation(fields: [ownerId], references: [id])
  category          Category?               @relation(fields: [categoryId], references: [id])
  city              City?                   @relation(fields: [cityId], references: [id])
  products          Product[]
  productCategories VendorProductCategory[]
  orderItems        OrderItem[]

  @@map("vendors")
}

model VendorProductCategory {
  id       String @id @default(cuid())
  vendorId String @map("vendor_id")
  name     String

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("vendor_product_categories")
}

// ============================================
// PRODUCTOS
// ============================================

model Product {
  id               String   @id @default(cuid())
  vendorId         String   @map("vendor_id")
  vendorCategoryId String?  @map("vendor_category_id")
  name             String
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  costPrice        Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  offerPrice       Decimal? @map("offer_price") @db.Decimal(10, 2)
  isOffer          Boolean  @default(false) @map("is_offer")
  isFeatured       Boolean  @default(false) @map("is_featured")
  imageUrl         String?  @map("image_url")
  stock            Int      @default(0)
  packagingFee     Decimal? @map("packaging_fee") @db.Decimal(10, 2)
  cutleryPrice     Decimal? @map("cutlery_price") @db.Decimal(10, 2)
  cutleryCostPrice Decimal? @map("cutlery_cost_price") @db.Decimal(10, 2)
  hasVariants      Boolean  @default(false) @map("has_variants")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  vendor         Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorCategory VendorProductCategory? @relation(fields: [vendorCategoryId], references: [id])
  drinks         ProductDrink[]
  variants       ProductVariant[]
  orderItems     OrderItem[]

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  name      String // Ej: "Personal", "Mediana", "Familiar"
  price     Decimal @db.Decimal(10, 2)
  costPrice Decimal @default(0) @map("cost_price") @db.Decimal(10, 2)
  stock     Int? // Stock específico por variante (opcional)
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductDrink {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  name      String
  price     Decimal @db.Decimal(10, 2)
  costPrice Decimal @default(0) @map("cost_price") @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_drinks")
}

// ============================================
// DRIVERS (REPARTIDORES)
// ============================================

model Driver {
  id               String            @id @default(cuid())
  userId           String?           @unique @map("user_id")
  name             String
  email            String
  dni              String?
  phone            String?
  vehicle          VehicleType
  status           EntityStatus      @default(Pendiente)
  commissionRate   Decimal           @default(0) @map("commission_rate") @db.Decimal(5, 2)
  debt             Decimal           @default(0) @db.Decimal(10, 2)
  address          String?
  city             String?
  sector           String?
  lat              Decimal?          @db.Decimal(10, 8)
  lng              Decimal?          @db.Decimal(11, 8)
  documentImageUrl String?           @map("document_image_url")
  profileImageUrl  String?           @map("profile_image_url")
  paymentMethod    PaymentMethodType @default(bank) @map("payment_method")
  bankAccount      String?           @map("bank_account")
  qrImageUrl       String?           @map("qr_image_url")
  qrPaymentName    String?           @map("qr_payment_name")
  rating           Decimal?          @db.Decimal(3, 2)
  deliveries       Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user             User?                   @relation(fields: [userId], references: [id])
  debtTransactions DriverDebtTransaction[]
  orders           Order[]
  favors           Favor[]

  @@map("drivers")
}

model DriverDebtTransaction {
  id          String          @id @default(cuid())
  driverId    String          @map("driver_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_debt_transactions")
}

// ============================================
// PEDIDOS
// ============================================

model Order {
  id                 String      @id // ORD-{timestamp}
  userId             String?     @map("user_id")
  driverId           String?     @map("driver_id")
  customerName       String      @map("customer_name")
  customerPhone      String?     @map("customer_phone")
  customerAddress    String      @map("customer_address")
  customerLat        Decimal?    @map("customer_lat") @db.Decimal(10, 8)
  customerLng        Decimal?    @map("customer_lng") @db.Decimal(11, 8)
  status             OrderStatus @default(Procesando)
  total              Decimal     @db.Decimal(10, 2)
  shippingFee        Decimal     @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  paymentMethod      String?     @map("payment_method")
  paymentProofUrl    String?     @map("payment_proof_url")
  driverPayoutStatus String      @default("pending") @map("driver_payout_status")
  verificationCode   String?     @map("verification_code")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user     User?       @relation(fields: [userId], references: [id])
  driver   Driver?     @relation(fields: [driverId], references: [id])
  items    OrderItem[]
  messages Message[]

  @@map("orders")
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  productId        String?  @map("product_id")
  vendorId         String?  @map("vendor_id")
  productName      String   @map("product_name")
  vendorName       String   @map("vendor_name")
  quantity         Int
  price            Decimal  @db.Decimal(10, 2)
  costPrice        Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  payoutStatus     String   @default("pending") @map("payout_status")
  hasCutlery       Boolean  @default(false) @map("has_cutlery")
  cutleryPrice     Decimal? @map("cutlery_price") @db.Decimal(10, 2)
  cutleryCostPrice Decimal? @map("cutlery_cost_price") @db.Decimal(10, 2)
  drinkName        String?  @map("drink_name")
  drinkPrice       Decimal? @map("drink_price") @db.Decimal(10, 2)
  drinkCostPrice   Decimal? @map("drink_cost_price") @db.Decimal(10, 2)
  variantName      String?  @map("variant_name") // Nombre de la variante seleccionada
  variantPrice     Decimal? @map("variant_price") @db.Decimal(10, 2) // Precio de la variante

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  vendor  Vendor?  @relation(fields: [vendorId], references: [id])

  @@map("order_items")
}

// ============================================
// MENSAJES
// ============================================

model Message {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  senderId   String?  @map("sender_id")
  senderType String   @map("sender_type") // 'customer', 'driver'
  senderName String?  @map("sender_name")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User? @relation(fields: [senderId], references: [id])

  @@map("messages")
}

// ============================================
// FAVORES (ENCARGOS)
// ============================================

model Favor {
  id                   String      @id @default(cuid())
  userId               String?     @map("user_id")
  driverId             String?     @map("driver_id")
  userName             String?     @map("user_name")
  description          String
  pickupAddress        String      @map("pickup_address")
  deliveryAddress      String      @map("delivery_address")
  pickupLat            Decimal?    @map("pickup_lat") @db.Decimal(10, 8)
  pickupLng            Decimal?    @map("pickup_lng") @db.Decimal(11, 8)
  deliveryLat          Decimal?    @map("delivery_lat") @db.Decimal(10, 8)
  deliveryLng          Decimal?    @map("delivery_lng") @db.Decimal(11, 8)
  estimatedProductCost Decimal?    @map("estimated_product_cost") @db.Decimal(10, 2)
  photoUrl             String?     @map("photo_url")
  quoteData            Json?       @map("quote_data")
  status               FavorStatus @default(Pendiente)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  user   User?   @relation(fields: [userId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@map("favors")
}

// ============================================
// CARRITOS
// ============================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

// ============================================
// MONEDAS Y RECOMPENSAS
// ============================================

model CoinTransaction {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  type           CoinTransactionType
  amount         Int
  reason         String?
  description    String?
  relatedOrderId String?             @map("related_order_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_transactions")
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  coinsCost   Int      @map("coins_cost")
  imageUrl    String?  @map("image_url")
  type        String // 'discount', 'freeDelivery', 'product', 'voucher'
  value       Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("rewards")
}

// ============================================
// ADMINS
// ============================================

model Admin {
  id          String  @id @default(cuid())
  userId      String? @unique @map("user_id")
  name        String
  email       String
  phone       String?
  permissions Json    @default("[]")

  user User? @relation(fields: [userId], references: [id])

  @@map("admins")
}

// ============================================
// BANNERS
// ============================================

model PromotionalBanner {
  id          String   @id @default(cuid())
  imageUrl    String   @map("image_url")
  title       String?
  description String?
  link        String?
  imageHint   String?  @map("image_hint")
  locations   Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("promotional_banners")
}

model AnnouncementBanner {
  id          String   @id @default(cuid())
  imageUrl    String   @map("image_url")
  title       String?
  description String?
  link        String?
  imageHint   String?  @map("image_hint")
  locations   Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("announcement_banners")
}

// ============================================
// METODOS DE PAGO DEL SISTEMA
// ============================================

model BankAccount {
  id            String @id @default(cuid())
  bankName      String @map("bank_name")
  accountNumber String @map("account_number")
  accountHolder String @map("account_holder")
  country       String @default("Peru")

  @@map("bank_accounts")
}

model QrPayment {
  id           String  @id @default(cuid())
  name         String
  qrImageUrl   String  @map("qr_image_url")
  instructions String?

  @@map("qr_payments")
}

// ============================================
// CONFIGURACION DE LA APP
// ============================================

model AppSettings {
  id                      Int      @id @default(1)
  appName                 String   @default("Pakiip") @map("app_name")
  logoUrl                 String?  @map("logo_url")
  heroImageUrl            String?  @map("hero_image_url")
  welcomeImageUrl         String?  @map("welcome_image_url")
  driverWelcomeImageUrl   String?  @map("driver_welcome_image_url")
  loginBackgroundImageUrl String?  @map("login_background_image_url")
  hideFooter              Boolean  @default(false) @map("hide_footer")
  taxType                 TaxType  @default(exonerada) @map("tax_type")
  taxRate                 Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxExemptRegions        Json     @default("[]") @map("tax_exempt_regions")
  currencySymbol          String   @default("S/") @map("currency_symbol")
  verificationMethods     Json     @default("{\"email\": true, \"phone\": false, \"google\": true}") @map("verification_methods")
  enablePasswordRecovery  Boolean  @default(true) @map("enable_password_recovery")
  featuredStoreCost       Decimal  @default(0) @map("featured_store_cost") @db.Decimal(10, 2)
  customDomain            String?  @map("custom_domain")
  shippingSettings        Json     @default("{}") @map("shipping_settings")
  cashOnDeliveryEnabled   Boolean  @default(true) @map("cash_on_delivery_enabled")
  // Campos adicionales para pagos y banners
  paymentMethods          Json     @default("{}") @map("payment_methods")
  promotionalBanners      Json     @default("[]") @map("promotional_banners")
  announcementBanners     Json     @default("[]") @map("announcement_banners")
  googleClientId          String?  @map("google_client_id")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
